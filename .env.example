# =====================================================================
# PLANTILLA DE CONFIGURACIÓN
# Copiar a .env y rellenar. NUNCA versionar el .env resultante.
# =====================================================================

# ---- General ----
TZ=America/Mexico_City
ENTORNO=desarrollo


# ---- Origen: SQL Server Intelix ----
# Segundo origen SQL Server (servidor WS-OVH-BDD-REPORT\BDD, definitivo para
# esta vista). Ver grafana/provisioning/datasources/mssql-intelix.yaml.
# Patrón a replicar (MSSQL_<NOMBRE>_*) si se agregan más orígenes a futuro.
MSSQL_INTELIX_HOST=
MSSQL_INTELIX_PORT=
MSSQL_INTELIX_DB=
MSSQL_INTELIX_USER=
MSSQL_INTELIX_PASS=
MSSQL_INTELIX_ENCRYPT=yes
MSSQL_INTELIX_TRUST_CERT=yes

# ---- Dashboard HTML standalone (rama alterna, sin Grafana) ----
# dashboard-etl corre `SELECT *` sobre vw_dashboard_usuarios_intelix con el
# horario de abajo y escribe SNAPSHOT_OUTPUT_PATH; dashboard-web (nginx) lo
# sirve protegido con auth básica. Ver docs/ARQUITECTURA.md.
SNAPSHOT_CRON_SCHEDULE=0 6 * * *
SNAPSHOT_OUTPUT_PATH=/data/snapshot.json
NGINX_BASIC_AUTH_USER=
NGINX_BASIC_AUTH_PASS=

# Nota: esta rama no usa el datasource "SQL Server Concentra" (principal) ni
# Grafana — esas variables (MSSQL_HOST/MSSQL_USER_GRAFANA/GF_*) solo existen
# en la rama `main`.
