# =====================================================================
# PLANTILLA DE CONFIGURACIÓN
# Copiar a .env y rellenar. NUNCA versionar el .env resultante.
# =====================================================================

# ---- General ----
TZ=America/Mexico_City
ENTORNO=desarrollo


# ---- Origen: SQL Server Intelix 1 (tabla cruda de conexiones) ----
# Servidor 10.80.11.70\DEV (instancia nombrada, sin puerto fijo), base
# gc_wfm, tabla dbo.tbl_dashboard_users_intelix — llenada por un job aparte,
# este proyecto solo la lee. Es la fuente del dashboard portado de
# "dash_conexiones_intelix" (ver docs/ARQUITECTURA.md). Distinta de la vista
# agregada que usa el datasource de Grafana en `main`.
MSSQL_INTELIX_1_HOST=10.80.11.70\DEV
MSSQL_INTELIX_1_DB=gc_wfm
MSSQL_INTELIX_1_USER=
MSSQL_INTELIX_1_PASS=
MSSQL_INTELIX_1_ENCRYPT=no
MSSQL_INTELIX_1_TRUST_CERT=yes

# ---- Dashboard HTML standalone (rama alterna, sin Grafana) ----
# dashboard-etl extrae la tabla de arriba con el horario de abajo y escribe
# SNAPSHOT_OUTPUT_PATH (datos.js); dashboard-web (nginx) lo sirve protegido
# con auth básica. Ver docs/ARQUITECTURA.md.
SNAPSHOT_CRON_SCHEDULE=0 6 * * *
SNAPSHOT_OUTPUT_PATH=/data/datos.js
NGINX_BASIC_AUTH_USER=
NGINX_BASIC_AUTH_PASS=

# Nota: esta rama no usa el datasource "SQL Server Concentra" (principal) ni
# Grafana — esas variables (MSSQL_HOST/MSSQL_USER_GRAFANA/GF_*) solo existen
# en la rama `main`.
