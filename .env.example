# =====================================================================
# PLANTILLA DE CONFIGURACIÓN
# Copiar a .env y rellenar. NUNCA versionar el .env resultante.
# =====================================================================

# ---- General ----
TZ=America/Mexico_City
ENTORNO=desarrollo


# ---- Origen: SQL Server DataSourceX ----
MSSQL_DataSourceX_HOST=
MSSQL_DataSourceX_DB=
MSSQL_DataSourceX_USER=
MSSQL_DataSourceX_PASS=
MSSQL_DataSourceX_ENCRYPT=yes
MSSQL_DataSourceX_TRUST_CERT=yes

# ---- Origen: SQL Server ----
# Grafana consulta esta base directamente (datasource nativo mssql, sin capa
# intermedia). Ver docs/ARQUITECTURA.md para el criterio de cuándo revisar
# esta decisión.
MSSQL_HOST=10.80.12.2
MSSQL_PORT=54441
MSSQL_DB=
MSSQL_USER_GRAFANA=bi_grafana_ro
MSSQL_PASS_GRAFANA=
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERT=yes

# ---- Origen: MariaDB ----
# Fuera de alcance: la hipótesis inicial de usar MariaDB como origen se
# descartó (el origen confirmado es SQL Server). Se deja comentado, no
# eliminado, porque es reincorporable si el alcance cambia.
# MARIADB_HOST=10.70.13.70
# MARIADB_PORT=3306
# MARIADB_DB=
# MARIADB_USER_GRAFANA=bi_grafana_ro
# MARIADB_PASS_GRAFANA=
# MARIADB_USER_ETL=bi_etl_ro
# MARIADB_PASS_ETL=

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_ROOT_URL=http://localhost:3000
GF_USERS_ALLOW_SIGN_UP=false
